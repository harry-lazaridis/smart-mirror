# Firebase Functions runtime env
CLIENT_URL=https://blackmirror-ff202.web.app
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://blackmirror-ff202.web.app/api/auth/google/callback
OPEN_WEATHER_API=your_openweather_api_key

# Optional only when running backend outside Firebase Functions with service account envs
FIREBASE_PROJECT_ID=blackmirror-ff202
FIREBASE_CLIENT_EMAIL=your_service_account_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
